# --- Judge LLM (matches resume: GPT-4o) ---
OPENAI_API_KEY=sk-...

# --- Demo pipeline's generator LLM (cheap/free tier for iteration) ---
GROQ_API_KEY=gsk_...

# --- Qdrant: embedded local mode, no server needed. This is a filesystem path. ---
QDRANT_LOCAL_PATH=./qdrant_data

# --- Postgres: native brew-installed instance ---
# brew services start postgresql@16
# createdb rag_eval
DATABASE_URL=postgresql://localhost:5432/rag_eval

# --- Regression gate ---
BASELINE_DROP_THRESHOLD=0.05
